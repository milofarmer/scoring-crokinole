{
  "name": "crokinole-app",
  "version": "2.0.0",
  "private": true,
  "description": "Crokinole tournament scoring: phone entry, live big board, knockout bracket, and NCA Field-Weighted Points season ranking",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.7.0",
    "eslint": "^9.36.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
